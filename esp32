    uvScheduleOnHour = constrain(uvScheduleOnHour, 0, 23);
    uvScheduleOffHour = constrain(uvScheduleOffHour, 0, 23);
    uvScheduleOnMinute = constrain(uvScheduleOnMinute, 0, 59);
    uvScheduleOffMinute = constrain(uvScheduleOffMinute, 0, 59);
    if (!persistScheduleSettings()) {
      server.send(503, "application/json", "{\"schedule\":\"not_saved\"}");
      return;
    }

    server.send(
      200,
      "application/json",
      "{\"schedule\":\"saved\"}"
    );
  }

  void checkUvSchedule() {

    if (
      !uvScheduleEnabled
    )
      return;

    struct tm localTime;
    if (!getDeviceLocalTime(localTime)) return;
    int nowMins = localTime.tm_hour * 60 + localTime.tm_min;

    int onMins=
      uvScheduleOnHour*60+
      uvScheduleOnMinute;

    int offMins=
      uvScheduleOffHour*60+
      uvScheduleOffMinute;

    bool shouldBeOn=
      (onMins<offMins)
        ?
        (
          nowMins>=onMins &&
          nowMins<offMins
        )
        :
        (
          nowMins>=onMins ||
          nowMins<offMins
        );

    if (
      shouldBeOn &&
      !uvState &&
      uvOnDuration==0
    ) {

      uvState=true;

      uvTurnedOnAt=
        millis();

      digitalWrite(
        UV_PIN,
        HIGH
      );

    } else if (
      !shouldBeOn &&
      uvState &&
      uvOnDuration==0
    ) {

      uvState=false;

      digitalWrite(
        UV_PIN,
        LOW
      );
    }
  }

  // ========================
  // LED
  // ========================

  void handleLED() {

    if (
      ledState &&
      ledOnDuration>0
    ) {

      if (
        millis()-ledTurnedOnAt
        >=ledOnDuration
      ) {

        ledOnDuration=0;
        setLedState(false, "TIMER OFF");
      }
    }

    if (ledState)
      ledTotalOnMs +=
        millis()-ledLastTickAt;

    ledLastTickAt=
      millis();

  }

  void handleLedStatus() {

    unsigned long remaining=0;

    if (
      ledState &&
      ledOnDuration>0
    ) {

      unsigned long elapsed=
        millis()-ledTurnedOnAt;

      remaining=
        elapsed<ledOnDuration
          ?ledOnDuration-elapsed
          :0;
    }

    char sOn[6];
    char sOff[6];

    sprintf(
      sOn,
      "%02d:%02d",
      ledScheduleOnHour,
      ledScheduleOnMinute
    );

    sprintf(
      sOff,
      "%02d:%02d",
      ledScheduleOffHour,
      ledScheduleOffMinute
    );

    String json="{";

    json +=
      "\"led_on\":"+
      String(
        ledState
          ?"true"
          :"false"
      )+",";

    json +=
      "\"remaining_ms\":"+
      String(
        remaining
      )+",";

    json +=
      "\"total_on_ms\":"+
      String(
        ledTotalOnMs
      )+",";

    json +=
      "\"schedule_enabled\":"+
      String(
        ledScheduleEnabled
          ?"true"
          :"false"
      )+",";

    json +=
      "\"sched_on\":\""+
      String(sOn)+
      "\",";

    json +=
      "\"sched_off\":\""+
      String(sOff)+
      "\"";

    json+="}";

    server.send(
      200,
      "application/json",
      json
    );
  }

