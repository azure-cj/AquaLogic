  int getAverageAnalog(
    int pin
  ) {

    long total=0;

    for (
      int i=0;
      i<10;
      i++
    ) {

      total +=
        analogRead(pin);

      delay(1);
    }

    return total/10;
  }

  float calibrateTurbidityNTU(
    float voltage
  ) {

    float estimatedNtu;

    if (
      voltage>=TURBIDITY_CLEAN_VOLTAGE
    )
      estimatedNtu=0.0f;

    else if (
      voltage>=TURBIDITY_5_NTU_VOLTAGE
    )
      estimatedNtu=
        (TURBIDITY_CLEAN_VOLTAGE-voltage)*
        (5.0f/(TURBIDITY_CLEAN_VOLTAGE-TURBIDITY_5_NTU_VOLTAGE));

    else if (
      voltage>=TURBIDITY_10_NTU_VOLTAGE
    )
      estimatedNtu=
        5.0f+
        (TURBIDITY_5_NTU_VOLTAGE-voltage)*
        (5.0f/(TURBIDITY_5_NTU_VOLTAGE-TURBIDITY_10_NTU_VOLTAGE));

    else
      estimatedNtu=
        10.0f+
        (TURBIDITY_10_NTU_VOLTAGE-voltage)*
        (5.0f/(TURBIDITY_5_NTU_VOLTAGE-TURBIDITY_10_NTU_VOLTAGE));

    return constrain(
      estimatedNtu,
      0.0f,
      3000.0f
    );
  }

  float calibrateTdsPPM(
    float voltage,
    float temperature
  ) {

    if (
      voltage<=0.0f
    )
      return 0.0f;

    float compensationCoefficient=
      1.0f+
      0.02f*
      (temperature-25.0f);

    float compensatedVoltage=
      voltage/
      compensationCoefficient;

    float tds=
      (
        133.42f*
        compensatedVoltage*
        compensatedVoltage*
        compensatedVoltage

        -
        255.86f*
        compensatedVoltage*
        compensatedVoltage

        +
        857.39f*
        compensatedVoltage
      )*
      0.5f;

    return constrain(
      tds,
      0.0f,
      3000.0f
    );
  }

  // ========================
  // EVALUATION
  // ========================

  void evaluateTemperature() {

    if (
      temperatureC==
      DEVICE_DISCONNECTED_C
    )
      tempStatus=
        "NO SENSOR";

    else if (
      temperatureC>=24 &&
      temperatureC<=30
    )
      tempStatus=
        "NORMAL";

    else if (
      temperatureC>30
    )
      tempStatus=
        "HIGH";

    else
      tempStatus=
        "LOW";
  }

  void evaluatePH() {

    if (
      phValue>=6.8f &&
      phValue<=7.8f
    )
      phStatus=
        "NORMAL";

    else if (
      (
        phValue>=6.5f &&
        phValue<6.8f
      ) ||
      (
        phValue>7.8f &&
        phValue<=8.5f
      )
    )
      phStatus=
        "WARNING";

    else
      phStatus=
        "CRITICAL";
  }

  void evaluateTurbidity() {

    if (
      turbidityNtu<=5.0f
    )
      turbidityStatus=
        "CLEAR";

    else if (
      turbidityNtu<=10.0f
    )
      turbidityStatus=
        "MODERATE";

    else
      turbidityStatus=
        "DIRTY";
  }

  void evaluateTDS() {

    if (
      tdsPpm<=400.0f
    )
      tdsStatus=
        "NORMAL";

    else if (
      tdsPpm<=500.0f
    )
      tdsStatus=
        "WARNING";

    else
      tdsStatus=
        "HIGH";
  }

  void evaluateOverallStatus() {

    if (
      tempStatus=="NORMAL" &&
      turbidityStatus=="CLEAR" &&
      tdsStatus=="NORMAL" &&
      phStatus=="NORMAL"
    )
      overallStatus=
        "GOOD";

    else if (
      turbidityStatus=="DIRTY" ||
      tdsStatus=="HIGH" ||
      phStatus=="CRITICAL"
    )
      overallStatus=
        "CRITICAL";

    else
      overallStatus=
        "MONITOR";
  }

