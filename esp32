  void startSyringeAMove(
    long steps,
    bool isDose,
    bool chemicalDose=false
  ) {

    if (syringeAActive)
      return;

    if (syringeBActive)
      return;

    syringeAActive=true;

    if (isDose)
      syringeADoseCount++;

    stepperA.setMaxSpeed(
      syringeASpeed
    );

    stepperA.setAcceleration(
      syringeASpeed*2
    );

    stepperA.move(steps);

    if (isDose) {
      syringeALastDispensed = deviceClockSynchronized()
        ? formatDeviceEpoch(time(nullptr))
        : "Time not synchronized";
    }

      Serial.print(
        isDose
          ? (chemicalDose ? "SYRINGE A CHEMICAL DOSE — volume: " : "SYRINGE A WATER TEST — volume: ")
          : "SYRINGE A RETRACT — "
      );

    if (isDose) {

      Serial.print(
        syringeADispenseML
      );

      Serial.print("mL  ");
    }

    Serial.print(
      "steps: "
    );

    Serial.println(steps);
  }

  // VOLUME LIMITER: refuses to dispense if not enough liquid remains in the
  // 5mL syringe. Called by manual dispense, scheduled dispense, AND auto-dosing —
  // so all three paths share the same protection. Returns true if the dose fired.

  bool triggerSyringeA(bool chemicalDose=true) {
    pumpDoseBlockReason = "";
    if (!persistentStateReady) pumpDoseBlockReason = "Persistent safety state unavailable";
    else if (!syringeAVolumeKnown) pumpDoseBlockReason = "Check syringe contents and confirm refill first";
    else if (syringeARemainingML + 0.001f < syringeADispenseML)
      pumpDoseBlockReason = "Insufficient volume; refill confirmation required";
    else if (syringeAActive || syringeBActive) pumpDoseBlockReason = "A pump is already active";
    else if (chemicalDose && !deviceClockSynchronized()) pumpDoseBlockReason = "Waiting for Asia/Manila NTP time sync";

    time_t now = time(nullptr);
    if (pumpDoseBlockReason.length() == 0 && chemicalDose && lastChemicalDoseEpoch > 0 && now < lastChemicalDoseEpoch + 7200)
      pumpDoseBlockReason = "Two-hour chemical-dose cooldown until " + formatDeviceEpoch(lastChemicalDoseEpoch + 7200);

    if (pumpDoseBlockReason.length() > 0) {
      Serial.println("SYRINGE A BLOCKED — " + pumpDoseBlockReason);
      return false;
    }

    float oldRemaining = syringeARemainingML;
    time_t oldLastChemicalDose = lastChemicalDoseEpoch;
    int oldDoseCount = syringeADoseCount;
    String oldLastDispensed = syringeALastDispensed;
    long steps = (long)(syringeADispenseML * syringeAStepsPerML);
    startSyringeAMove(steps, true, chemicalDose);
    if (!syringeAActive) {
      pumpDoseBlockReason = "Pump could not start";
      return false;
    }
    syringeARemainingML -= syringeADispenseML;
    if (chemicalDose) {
      lastChemicalDoseEpoch = now;
      lastPhDoseMs = millis();
    }

    // Persist before loop() services the stepper, making the dose non-repeatable
    // after a reset or a lost HTTP response.
    if (!persistPumpSafetyState()) {
      stopSyringeA();
      syringeARemainingML = oldRemaining;
      lastChemicalDoseEpoch = oldLastChemicalDose;
      syringeADoseCount = oldDoseCount;
      syringeALastDispensed = oldLastDispensed;
      pumpDoseBlockReason = "Could not persist pump safety state; dose not started";
      return false;
    }
    return true;
  }

  // FIXED: full retract stroke — pulls the plunger all the way back
  // (draws a fresh full syringe from the reservoir) instead of only reversing
  // the last dose amount. Also resets the volume tracker to full capacity,
  // since a full retract means the syringe is now full again.

  void retractSyringeA() {

    long fullStrokeSteps =
      (long)(
        syringeACapacityML *
        syringeAStepsPerML
      );

    startSyringeAMove(
      -fullStrokeSteps,
      false
    );

    Serial.println("SYRINGE A RETRACT — volume estimate unchanged");
  }

  void handleSyringeA() {

    if (!syringeAActive)
      return;

    stepperA.run();

    if (
      stepperA.distanceToGo()==0
    ) {

      syringeAActive=false;

      stepperA.disableOutputs();

      Serial.println(
        "SYRINGE A DOSE COMPLETE"
      );
    }
  }

  void stopSyringeA() {

    if (!syringeAActive)
      return;

    stepperA.setCurrentPosition(
      stepperA.currentPosition()
    );

    syringeAActive=false;

    stepperA.disableOutputs();

    Serial.println(
      "SYRINGE A STOPPED (manual)"
    );
  }

  void checkSyringeASchedule() {
    struct tm localTime;
    if (!getDeviceLocalTime(localTime)) return;
    int nowMin = localTime.tm_hour * 60 + localTime.tm_min;
    int today = deviceDateKey(localTime);

    for (int i = 0; i < 3; i++) {
      if (!syringeASchedule[i].enabled) continue;
      int slotMin = syringeASchedule[i].hour * 60 + syringeASchedule[i].minute;
      if (nowMin != slotMin || syringeALastFiredDate[i] == today) continue;

      // Consume this local-date slot before checking the pump. Cooldown, volume,
      // an active pump, or a storage fault skips this occurrence without catch-up.
      syringeALastFiredDate[i] = today;
      char key[12];
      snprintf(key, sizeof(key), "a_fire%d", i);
      if (!persistentStateReady || devicePreferences.putInt(key, today) == 0) {
        setPumpScheduleEvent(true, "Pump A scheduled dose skipped: could not persist occurrence");
        continue;
      }

      if (triggerSyringeA(true)) {
        setPumpScheduleEvent(true, "Pump A scheduled " + String(syringeADispenseML, 2) +
          " mL dose started at " + formatDeviceEpoch(time(nullptr)));
      } else {
        setPumpScheduleEvent(true, "Pump A scheduled dose skipped: " + pumpDoseBlockReason);
      }
    }
  }

