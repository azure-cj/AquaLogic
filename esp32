    struct tm localTime;
    if (!getDeviceLocalTime(localTime)) return;
    int nowMin = localTime.tm_hour * 60 + localTime.tm_min;
    int today = deviceDateKey(localTime);

    for (int i = 0; i < 3; i++) {
      if (!syringeBSchedule[i].enabled) continue;
      int slotMin = syringeBSchedule[i].hour * 60 + syringeBSchedule[i].minute;
      if (nowMin != slotMin || syringeBLastFiredDate[i] == today) continue;

      syringeBLastFiredDate[i] = today;
      char key[12];
      snprintf(key, sizeof(key), "b_fire%d", i);
      if (!persistentStateReady || devicePreferences.putInt(key, today) == 0) {
        setPumpScheduleEvent(false, "Pump B scheduled dose skipped: could not persist occurrence");
        continue;
      }

      if (triggerSyringeB(true)) {
        setPumpScheduleEvent(false, "Pump B scheduled " + String(syringeBDispenseML, 2) +
          " mL dose started at " + formatDeviceEpoch(time(nullptr)));
      } else {
        setPumpScheduleEvent(false, "Pump B scheduled dose skipped: " + pumpDoseBlockReason);
      }
    }
  }

  // ========================
  // pH AUTO-DOSING
  // ========================

  // checkPhAutoDose() calls triggerSyringeA()/B(), which internally enforce
  // the 5mL volume limit. When a dose succeeds AND we're in demoMode (no real
  // chemicals), we simulate the correction by snapping the fake pH reading
  // back to the midpoint of the target range — this closes the demo loop
  // without needing to manually reset the pH value after each auto-dose.

  void checkPhAutoDose() {

    if (!phAutoDoseEnabled)
      return;

    if (
      syringeAActive ||
      syringeBActive
    )
      return;

    if (
      millis()-lastPhDoseMs <
      phDoseCooldownMs
    )
      return;

    if (
      phValue <
      phTargetMin
    ) {

      bool ok =
        triggerSyringeA();

      if (ok) {

        phAutoLastAction =
          "AUTO: pH UP dosed at pH "+
          String(phValue,2);

        if (demoMode) {

          demoPhValue =
            (
              phTargetMin+
              phTargetMax
            )/2.0f;

          phAutoLastAction +=
            " — pH reading updated to "+
            String(
              demoPhValue,
              2
            )+
            " (demo)";
        }

      } else {

        phAutoLastAction =
          "AUTO: pH UP BLOCKED — Syringe A low volume ("+
          String(
            syringeARemainingML,
            1
          )+
          "mL left)";
      }

      Serial.println(
        phAutoLastAction
      );

    } else if (
      phValue >
      phTargetMax
    ) {

      bool ok =
        triggerSyringeB();

      if (ok) {

        phAutoLastAction =
          "AUTO: pH DOWN dosed at pH "+
          String(phValue,2);

        if (demoMode) {

          demoPhValue =
            (
              phTargetMin+
              phTargetMax
            )/2.0f;

          phAutoLastAction +=
            " — pH reading updated to "+
            String(
              demoPhValue,
              2
            )+
            " (demo)";
        }

      } else {

        phAutoLastAction =
          "AUTO: pH DOWN BLOCKED — Syringe B low volume ("+
          String(
            syringeBRemainingML,
            1
          )+
          "mL left)";
      }

      Serial.println(
        phAutoLastAction
      );
    }
  }

