  bool getDeviceLocalTime(struct tm& localTime) {
    time_t now = time(nullptr);
    if (now < MIN_VALID_NTP_EPOCH) return false;
    return localtime_r(&now, &localTime) != nullptr;
  }

  bool parseIntegerValue(const String& text, long minimum, long maximum, long& value) {
    if (text.isEmpty()) return false;
    const char* start = text.c_str();
    char* end = nullptr;
    long parsed = strtol(start, &end, 10);
    if (end == start || *end != '\0' || parsed < minimum || parsed > maximum)
      return false;
    value = parsed;
    return true;
  }

  bool parseOptionalInteger(WebServer& request, const String& name,
                            long minimum, long maximum, long& value) {
    if (!request.hasArg(name)) return true;
    return parseIntegerValue(request.arg(name), minimum, maximum, value);
  }

