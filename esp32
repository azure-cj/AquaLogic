  void handleLedTimer() {

    if (
      server.hasArg("duration")
    ) {

      ledOnDuration=
        server.arg(
          "duration"
        ).toInt();

      ledManualOverride=false;

      ledTurnedOnAt=
        millis();

      setLedState(true, "TIMER ON");

      server.send(
