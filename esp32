  }

  String formatDeviceEpoch(time_t epoch) {
    if (epoch < MIN_VALID_NTP_EPOCH) return "";
    struct tm localTime;
    if (!localtime_r(&epoch, &localTime)) return "";
    char buffer[32];
    strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%S", &localTime);
    return String(buffer) + "+08:00";
  }

  String deviceCooldownRemainingText() {
    if (!deviceClockSynchronized()) return "Waiting for NTP time sync";
    time_t now = time(nullptr);
    if (lastChemicalDoseEpoch <= 0 || now >= lastChemicalDoseEpoch + 7200)
      return "Eligible now";
    return formatDeviceEpoch(lastChemicalDoseEpoch + 7200);
  }

  unsigned long chemicalCooldownRemainingMs() {
    if (!deviceClockSynchronized()) return CHEMICAL_DOSE_COOLDOWN_MS;
    time_t now = time(nullptr);
    if (lastChemicalDoseEpoch <= 0 || now >= lastChemicalDoseEpoch + 7200) return 0;
    return (unsigned long)(lastChemicalDoseEpoch + 7200 - now) * 1000UL;
  }

  time_t nextScheduleEpoch(const SyringeTime* schedule, time_t now) {
    struct tm localTime;
    if (!localtime_r(&now, &localTime)) return 0;
    time_t next = 0;
    for (int i = 0; i < 3; i++) {
      if (!schedule[i].enabled) continue;
      struct tm slot = localTime;
      slot.tm_hour = schedule[i].hour;
      slot.tm_min = schedule[i].minute;
      slot.tm_sec = 0;
      time_t candidate = mktime(&slot);
      if (candidate <= now) {
        slot.tm_mday += 1;
        candidate = mktime(&slot);
      }
      if (candidate > 0 && (next == 0 || candidate < next)) next = candidate;
    }
    return next;
  }

  time_t nextChemicalEligibleEpoch() {
    if (!deviceClockSynchronized()) return 0;
    time_t now = time(nullptr);
    time_t eligible = now;
    if (lastChemicalDoseEpoch > 0 && eligible < lastChemicalDoseEpoch + 7200)
      eligible = lastChemicalDoseEpoch + 7200;
    return eligible;
  }

  time_t nextPumpDoseEpoch(const SyringeTime* schedule) {
    if (!deviceClockSynchronized()) return 0;
    time_t eligible = nextChemicalEligibleEpoch();
    if (eligible <= 0) return 0;
    // If cooldown ends after a slot, report the next real schedule occurrence
    // after the cooldown. The crossed/blocked slot is skipped, not caught up.
    return nextScheduleEpoch(schedule, eligible - 1);
  }

