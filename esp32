  // DEMO/SIMULATION MAPPING — NOT LABORATORY CALIBRATION
  // This prototype demonstration mapping is based on observed sensor voltage.
  // Proper pH calibration with standard buffer solutions is required for real measurements.
  const float DEMO_PH_MIN = 5.0f;
  const float DEMO_PH_MAX = 10.0f;
  const float DEMO_PH_POINT_1_VOLTAGE = 0.50f;
  const float DEMO_PH_POINT_1_VALUE = 6.0f;
  const float DEMO_PH_POINT_2_VOLTAGE = 0.56f;
  const float DEMO_PH_POINT_2_VALUE = 6.5f;
  const float DEMO_PH_POINT_3_VOLTAGE = 0.62f;
  const float DEMO_PH_POINT_3_VALUE = 7.0f;
  const float DEMO_PH_POINT_4_VOLTAGE = 0.66f;
  const float DEMO_PH_POINT_4_VALUE = 7.8f;
  const float DEMO_PH_POINT_5_VOLTAGE = 0.70f;
  const float DEMO_PH_POINT_5_VALUE = 8.5f;

  float calculateDemoPH(float sensorVoltage) {
    float demoPh;
    if (sensorVoltage <= DEMO_PH_POINT_2_VOLTAGE) {
      demoPh = DEMO_PH_POINT_1_VALUE +
        (sensorVoltage - DEMO_PH_POINT_1_VOLTAGE) *
        (DEMO_PH_POINT_2_VALUE - DEMO_PH_POINT_1_VALUE) /
        (DEMO_PH_POINT_2_VOLTAGE - DEMO_PH_POINT_1_VOLTAGE);
    } else if (sensorVoltage <= DEMO_PH_POINT_3_VOLTAGE) {
      demoPh = DEMO_PH_POINT_2_VALUE +
        (sensorVoltage - DEMO_PH_POINT_2_VOLTAGE) *
        (DEMO_PH_POINT_3_VALUE - DEMO_PH_POINT_2_VALUE) /
        (DEMO_PH_POINT_3_VOLTAGE - DEMO_PH_POINT_2_VOLTAGE);
    } else if (sensorVoltage <= DEMO_PH_POINT_4_VOLTAGE) {
      demoPh = DEMO_PH_POINT_3_VALUE +
        (sensorVoltage - DEMO_PH_POINT_3_VOLTAGE) *
        (DEMO_PH_POINT_4_VALUE - DEMO_PH_POINT_3_VALUE) /
        (DEMO_PH_POINT_4_VOLTAGE - DEMO_PH_POINT_3_VOLTAGE);
    } else {
      demoPh = DEMO_PH_POINT_4_VALUE +
        (sensorVoltage - DEMO_PH_POINT_4_VOLTAGE) *
        (DEMO_PH_POINT_5_VALUE - DEMO_PH_POINT_4_VALUE) /
        (DEMO_PH_POINT_5_VOLTAGE - DEMO_PH_POINT_4_VOLTAGE);
    }
    return constrain(demoPh, DEMO_PH_MIN, DEMO_PH_MAX);
  }

