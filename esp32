  void enterManualOfflineMode() {
    if (mdnsStarted) {
      MDNS.end();
      mdnsStarted = false;
    }

    fallbackApActive = false;
    wifiDisconnectedAt = 0;
    staReconnectedAt = 0;
    fallbackApLastStartAt = 0;
    WiFi.disconnect(true);
    WiFi.mode(WIFI_AP);
    bool apStarted = WiFi.softAP(DEBUG_AP_SSID, DEBUG_AP_PASSWORD);
    manualOfflineMode = true;
    manualOfflineSetAt = millis();
    wifiConnected = false;
    wifiConnecting = false;

    Serial.print("Manual WiFi offline mode; AP ");
    Serial.print(apStarted ? "started at " : "failed: ");
    Serial.println(WiFi.softAPIP());
    printCurrentWifiIp("Manual offline mode");
    showManualWiFiNotice("LOCAL AP READY", "192.168.4.1");
  }

  void exitManualOfflineMode() {
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    manualOfflineMode = false;
    fallbackApActive = false;
    wifiDisconnectedAt = millis();
    staReconnectedAt = 0;
    fallbackApLastStartAt = 0;
    pendingManualReconnect = false;
    wifiConnecting = false;
    wifiLastRetryAt = 0;
    Serial.println("Manual WiFi offline mode ended; STA reconnect enabled");
  }

  void serviceManualWiFi() {
    if (pendingManualOffline) {
      pendingManualOffline = false;
      if (!manualOfflineMode) enterManualOfflineMode();
      return;
    }

    if (pendingManualReconnect) {
      if (manualOfflineMode) exitManualOfflineMode();
      else pendingManualReconnect = false;
    }

    if (manualOfflineMode && millis() - manualOfflineSetAt >= MANUAL_OFFLINE_MAX_MS) {
      pendingManualReconnect = true;
      Serial.println("MANUAL OFFLINE MODE AUTO-CLEARED (safety timeout)");
      showManualWiFiNotice("OFFLINE TIMEOUT", "RECONNECTING");
      exitManualOfflineMode();
    }
  }

  void serviceWiFi() {
    if (manualOfflineMode) return;

    unsigned long now = millis();
    bool connectedNow = WiFi.status() == WL_CONNECTED;
    if (connectedNow) {
      if (!wifiConnected) {
        wifiConnected = true;
        wifiConnecting = false;
        staReconnectedAt = now;
        Serial.print("[WIFI] STA reconnected: ");
        Serial.println(WiFi.localIP());
        printCurrentWifiIp("WiFi connected");
      }
      wifiDisconnectedAt = 0;
      if (!mdnsStarted && MDNS.begin("aqualogic")) {
        MDNS.addService("http", "tcp", 80);
        mdnsStarted = true;
        Serial.println("[WIFI] mDNS active: http://aqualogic.local");
      }

      if (fallbackApActive && staReconnectedAt != 0 &&
          now - staReconnectedAt >= FALLBACK_AP_SHUTDOWN_GRACE_MS) {
        WiFi.softAPdisconnect(true);
        WiFi.mode(WIFI_STA);
        fallbackApActive = false;
        staReconnectedAt = 0;
        fallbackApLastStartAt = 0;
        Serial.println("[RECOVERY] Fallback AP stopped after stable STA recovery");
      }
      return;
    }

    staReconnectedAt = 0;
    if (wifiConnected) {
      wifiConnected = false;
      wifiDisconnectedAt = now;
      if (mdnsStarted) {
        MDNS.end();
        mdnsStarted = false;
      }
      Serial.println("[WIFI] STA disconnected; offline buffering enabled");
    } else if (wifiDisconnectedAt == 0) {
      wifiDisconnectedAt = now;
    }

    if (!fallbackApActive && now - wifiDisconnectedAt >= FALLBACK_AP_DELAY_MS &&
        now - fallbackApLastStartAt >= WIFI_RETRY_INTERVAL_MS) {
      fallbackApLastStartAt = now;
      WiFi.mode(WIFI_AP_STA);
      fallbackApActive = WiFi.softAP(DEBUG_AP_SSID, DEBUG_AP_PASSWORD);
      if (fallbackApActive) {
        Serial.print("[WIFI] Fallback AP started at ");
        Serial.println(WiFi.softAPIP());
        printCurrentWifiIp("Automatic fallback mode");
      } else {
        WiFi.mode(WIFI_STA);
        Serial.println("Automatic fallback AP start failed; will retry");
      }
    }

    if (wifiConnecting && now - wifiConnectStartedAt < WIFI_CONNECT_TIMEOUT_MS) return;
    if (now - wifiLastRetryAt < WIFI_RETRY_INTERVAL_MS) return;

    WiFi.begin(ssid, password);
    wifiConnecting = true;
    wifiConnectStartedAt = now;
    wifiLastRetryAt = now;
  }

