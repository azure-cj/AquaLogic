    }
  }

  void handleLedSchedule() {
    bool scheduleWasEnabled = ledScheduleEnabled;

    if (
      server.hasArg("enabled")
    )
      ledScheduleEnabled=
        server.arg(
          "enabled"
        ).toInt()==1;

    if (
      server.hasArg("onH")
    )
      ledScheduleOnHour=
        server.arg(
          "onH"
        ).toInt();

    if (
      server.hasArg("onM")
    )
      ledScheduleOnMinute=
        server.arg(
          "onM"
        ).toInt();

    if (
      server.hasArg("offH")
    )
      ledScheduleOffHour=
        server.arg(
          "offH"
        ).toInt();

    if (
      server.hasArg("offM")
    )
      ledScheduleOffMinute=
        server.arg(
          "offM"
        ).toInt();

    ledScheduleOnHour = constrain(ledScheduleOnHour, 0, 23);
    ledScheduleOffHour = constrain(ledScheduleOffHour, 0, 23);
    ledScheduleOnMinute = constrain(ledScheduleOnMinute, 0, 59);
    ledScheduleOffMinute = constrain(ledScheduleOffMinute, 0, 59);
    if (!persistScheduleSettings()) {
      server.send(503, "application/json", "{\"schedule\":\"not_saved\"}");
      return;
    }
    ledManualOverride = false;
    ledScheduleWindowInitialized = false;
    if (scheduleWasEnabled != ledScheduleEnabled)
      Serial.printf("[LED] Schedule %s\n", ledScheduleEnabled ? "enabled" : "disabled");

    server.send(
      200,
      "application/json",
      "{\"schedule\":\"saved\"}"
    );
  }

  void checkLedSchedule() {

    if (
      !ledScheduleEnabled
    )
      return;

    struct tm localTime;
    if (!getDeviceLocalTime(localTime)) return;
    int nowMins = localTime.tm_hour * 60 + localTime.tm_min;

    int onMins=
      ledScheduleOnHour*60+
      ledScheduleOnMinute;

    int offMins=
      ledScheduleOffHour*60+
      ledScheduleOffMinute;

    bool shouldBeOn=
      (onMins<offMins)
        ?
        (
          nowMins>=onMins &&
          nowMins<offMins
        )
        :
        (
          nowMins>=onMins ||
          nowMins<offMins
        );

    if (!ledScheduleWindowInitialized) {
      ledScheduleWindowInitialized = true;
      ledScheduleWindowOn = shouldBeOn;
    } else if (ledScheduleWindowOn != shouldBeOn) {
      ledScheduleWindowOn = shouldBeOn;
      ledManualOverride = false;
    }

    if (!ledManualOverride && ledOnDuration == 0)
      setLedState(shouldBeOn, shouldBeOn ? "SCHEDULE ON" : "SCHEDULE OFF");
  }

