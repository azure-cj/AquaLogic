  uint32_t recordSeq(const String& record) {
    int marker = record.indexOf("\"seq\":");
    return marker < 0 ? 0 : strtoul(record.c_str() + marker + 6, NULL, 10);
  }

  void writeBufferMeta() {
    if (!littleFsAvailable) return;

    File meta = LittleFS.open("/meta.json", FILE_WRITE);
    if (!meta) return;

    meta.print("{\"next_seq\":");
    meta.print(nextSeq);
    meta.print(",\"acked_seq\":");
    meta.print(ackedSeq);
    meta.print(",\"dropped\":");
    meta.print(droppedRecords);
    meta.println("}");
    meta.close();
  }

  void loadBufferMeta() {
    if (!LittleFS.exists("/meta.json")) return;

    File meta = LittleFS.open("/meta.json", FILE_READ);
    if (!meta) return;

    String json = meta.readString();
    meta.close();

    int marker = json.indexOf("\"next_seq\":");
    if (marker >= 0) nextSeq = strtoul(json.c_str() + marker + 11, NULL, 10);

    marker = json.indexOf("\"acked_seq\":");
    if (marker >= 0) ackedSeq = strtoul(json.c_str() + marker + 12, NULL, 10);

    marker = json.indexOf("\"dropped\":");
    if (marker >= 0) droppedRecords = strtoul(json.c_str() + marker + 10, NULL, 10);

    if (nextSeq == 0) nextSeq = 1;
  }

  void reserveSequenceRange() {
    seqCursor = nextSeq;
    seqLimit = seqCursor + SEQ_RESERVATION_SIZE;
    nextSeq = seqLimit;
    writeBufferMeta();
  }

  void setupBufferStorage() {
    littleFsAvailable = LittleFS.begin(false);
    if (!littleFsAvailable) {
      Serial.println("LittleFS unavailable; using RAM-only offline buffer");
      return;
    }

    if (!LittleFS.exists("/buffer.ndjson") && LittleFS.exists("/buffer.bak")) {
      if (LittleFS.rename("/buffer.bak", "/buffer.ndjson"))
        Serial.println("[BACKLOG] Restored buffer backup");
    } else if (LittleFS.exists("/buffer.ndjson") && LittleFS.exists("/buffer.bak")) {
      LittleFS.remove("/buffer.bak");
    }
    if (LittleFS.exists("/buffer.ndjson") && LittleFS.exists("/buffer.tmp"))
      LittleFS.remove("/buffer.tmp");

    loadBufferMeta();
    reserveSequenceRange();
    Serial.println("LittleFS offline buffer ready");
  }

  String makeBufferedRecord() {
    if (seqCursor >= seqLimit) reserveSequenceRange();

    String record = "{\"seq\":" + String(seqCursor++) +
      ",\"temp_c\":" + String(temperatureC, 2) +
      ",\"temp_status\":\"" + tempStatus +
      "\",\"ph_value\":" + String(phValue, 2) +
      ",\"ph_status\":\"" + phStatus +
      "\",\"turbidity_ntu\":" + String(turbidityNtu, 1) +
      ",\"turbidity_status\":\"" + turbidityStatus +
      "\",\"tds_ppm\":" + String(tdsPpm, 0) +
      ",\"tds_status\":\"" + tdsStatus +
      "\",\"overall_status\":\"" + overallStatus + "\"}";
    return record;
  }

  bool flushOfflineBuffer();

  void queueOfflineReading() {
    if (wifiConnected) return;

    unsigned long now = millis();
    if (offlineLastQueuedAt != 0 && now - offlineLastQueuedAt < OFFLINE_QUEUE_INTERVAL_MS)
      return;
    offlineLastQueuedAt = now;

    String record = makeBufferedRecord();
    if (ramBufferCount >= RAM_QUEUE_CAPACITY && littleFsAvailable)
      flushOfflineBuffer();

    if (ramBufferCount >= RAM_QUEUE_CAPACITY) {
      droppedRecords++;
      Serial.printf("[OFFLINE] RAM queue full; reading seq=%lu not queued\n",
        (unsigned long)recordSeq(record));
      return;
    }

    ramBuffer[ramBufferCount++] = record;
    Serial.printf("[OFFLINE] Queuing sensor reading seq=%lu\n",
      (unsigned long)recordSeq(record));
  }

  void compactAckedBuffer() {
    if (!littleFsAvailable || !LittleFS.exists("/buffer.ndjson")) return;

    File source = LittleFS.open("/buffer.ndjson", FILE_READ);
    File temp = LittleFS.open("/buffer.tmp", FILE_WRITE);
    if (!source || !temp) {
      source.close();
      temp.close();
      return;
    }

    bool copySucceeded = true;
    while (source && source.available()) {
      String line = source.readStringUntil('\n');
      if (recordSeq(line) > ackedSeq && temp.println(line) != line.length() + 2) {
        copySucceeded = false;
        break;
      }
    }
    source.close();
    temp.close();

    if (!copySucceeded) {
      LittleFS.remove("/buffer.tmp");
      Serial.println("[BACKLOG] Compaction write failed; original retained");
      return;
    }

    if (LittleFS.exists("/buffer.bak") && !LittleFS.remove("/buffer.bak")) return;
    if (!LittleFS.rename("/buffer.ndjson", "/buffer.bak")) return;
    if (!LittleFS.rename("/buffer.tmp", "/buffer.ndjson")) {
      LittleFS.rename("/buffer.bak", "/buffer.ndjson");
      Serial.println("[BACKLOG] Compaction swap failed; original restored");
      return;
    }
    LittleFS.remove("/buffer.bak");
    writeBufferMeta();
    Serial.printf("[BACKLOG] Compacted through ACK seq=%lu\n", (unsigned long)ackedSeq);
  }

  bool ackedPortionExceedsThreshold() {
    if (!littleFsAvailable || !LittleFS.exists("/buffer.ndjson")) return false;

    File file = LittleFS.open("/buffer.ndjson", FILE_READ);
    uint32_t total = 0;
    uint32_t acknowledged = 0;
    while (file && file.available()) {
      uint32_t seq = recordSeq(file.readStringUntil('\n'));
      if (seq == 0) continue;
      total++;
      if (seq <= ackedSeq) acknowledged++;
    }
    file.close();
    return total > 0 && acknowledged * 4 >= total;
  }

  bool flushOfflineBuffer() {
    if (ramBufferCount == 0) return true;
    if (feederActive || syringeAActive || syringeBActive || !littleFsAvailable) return false;

    size_t bytesRequired = 0;
    for (uint8_t i = 0; i < ramBufferCount; i++)
      bytesRequired += ramBuffer[i].length() + 2;
    size_t totalBytes = LittleFS.totalBytes();
    size_t usedBytes = LittleFS.usedBytes();
    if (usedBytes > totalBytes || bytesRequired > totalBytes - usedBytes) {
      if (!bufferCapacityWarningReported)
        Serial.println("[OFFLINE] LittleFS capacity reached; RAM backlog retained");
      bufferCapacityWarningReported = true;
      return false;
    }

    File file = LittleFS.open("/buffer.ndjson", FILE_APPEND);
    if (!file) return false;

    uint8_t writtenCount = 0;
    while (writtenCount < ramBufferCount) {
      size_t expectedBytes = ramBuffer[writtenCount].length() + 2;
      if (file.println(ramBuffer[writtenCount]) != expectedBytes) break;
      writtenCount++;
    }
    file.flush();
    file.close();

    if (writtenCount > 0) {
      for (uint8_t i = writtenCount; i < ramBufferCount; i++)
        ramBuffer[i - writtenCount] = ramBuffer[i];
      ramBufferCount -= writtenCount;
    }

    if (ramBufferCount > 0) {
      Serial.println("[OFFLINE] LittleFS write incomplete; unwritten RAM records retained");
      return false;
    }

    bufferLastFlushAt = millis();
    bufferCapacityWarningReported = false;
    Serial.printf("[OFFLINE] Wrote %u queued readings to LittleFS\n", writtenCount);
    return true;
  }

  void serviceBufferStorage() {
    if (feederActive || syringeAActive || syringeBActive) return;

    if (ackWritePending) {
      if (pendingAckSeq > ackedSeq) ackedSeq = pendingAckSeq;
      ackWritePending = false;
      writeBufferMeta();
      // Keep acknowledged lines until they exceed 25% so routine bridge acks do not rewrite flash.
      if (ackedPortionExceedsThreshold()) compactAckedBuffer();
    }

    unsigned long now = millis();
    bool flushDue = wifiConnected || ramBufferCount >= RAM_QUEUE_MAX ||
      (ramBufferCount > 0 && now - bufferLastFlushAt >= BUFFER_FLUSH_INTERVAL_MS);
    if (ramBufferCount > 0 && flushDue &&
        now - bufferLastAttemptAt >= BUFFER_FLUSH_RETRY_INTERVAL_MS) {
      bufferLastAttemptAt = now;
      flushOfflineBuffer();
    }
  }

