      s==='DIRTY'||s==='CRITICAL'||s==='HIGH' ? 'danger' : 'warn';

    function phClass(s){
      return s==='CRITICAL'
        ? 'danger'
        : s==='ACIDIC'||s==='ALKALINE'
          ? 'warn'
          : 'ph';
    }

    function fmtMs(ms){
      if(ms<=0)return'—';

      const s=Math.floor(ms/1000);

      if(s<60)return s+'s';

      if(s<3600)
        return Math.floor(s/60)+'m '+(s%60)+'s';

      return Math.floor(s/3600)+'h '+Math.floor((s%3600)/60)+'m';
    }

    function fmtTotal(ms){
      const s=Math.floor(ms/1000);

      if(s<60)return s+'s';

      if(s<3600)
        return Math.floor(s/60)+'m '+(s%60)+'s';

      return Math.floor(s/3600)+'h '+Math.floor((s%3600)/60)+'m';
    }

