  void handleBacklog() {
    uint32_t limit = server.hasArg("limit") ? constrain(server.arg("limit").toInt(), 1, 200) : 50;
    String json = "[";
    uint32_t sent = 0;

    if (littleFsAvailable && LittleFS.exists("/buffer.ndjson")) {
      File file = LittleFS.open("/buffer.ndjson", FILE_READ);
      while (file && file.available() && sent < limit) {
        String line = file.readStringUntil('\n');
        if (recordSeq(line) > ackedSeq) {
          if (sent++ > 0) json += ",";
          json += line;
        }
      }
      file.close();
    }
    for (uint8_t i = 0; i < ramBufferCount && sent < limit; i++) {
      if (recordSeq(ramBuffer[i]) <= ackedSeq) continue;
      if (sent++ > 0) json += ",";
      json += ramBuffer[i];
    }
    json += "]";
    server.send(200, "application/json", json);
  }

  void handleBacklogCount() {
    uint32_t pending = 0;
    uint32_t oldest = 0;
    uint32_t newest = 0;
    if (littleFsAvailable && LittleFS.exists("/buffer.ndjson")) {
      File file = LittleFS.open("/buffer.ndjson", FILE_READ);
      while (file && file.available()) {
        uint32_t seq = recordSeq(file.readStringUntil('\n'));
        if (seq > ackedSeq) {
          pending++;
          if (oldest == 0) oldest = seq;
          newest = seq;
        }
      }
      file.close();
    }
    for (uint8_t i = 0; i < ramBufferCount; i++) {
      uint32_t seq = recordSeq(ramBuffer[i]);
      if (seq > ackedSeq) {
        pending++;
        if (oldest == 0) oldest = seq;
        newest = seq;
      }
    }

    String json = "{\"pending\":" + String(pending) +
      ",\"dropped\":" + String(droppedRecords) +
      ",\"oldest_seq\":" + String(oldest) +
      ",\"newest_seq\":" + String(newest) + "}";
    server.send(200, "application/json", json);
  }

  void handleBacklogAck() {
    if (!server.hasArg("upto")) {
      server.send(400, "application/json", "{\"error\":\"missing upto\"}");
      return;
    }

    String ackText = server.arg("upto");
    const char* ackStart = ackText.c_str();
    char* ackEnd = nullptr;
    unsigned long parsedAck = strtoul(ackStart, &ackEnd, 10);
    if (ackStart == ackEnd || *ackEnd != '\0' || ackStart[0] == '-' || parsedAck > UINT32_MAX) {
      server.send(400, "application/json", "{\"error\":\"invalid upto\"}");
      return;
    }
    uint32_t requested = (uint32_t)parsedAck;

    if (requested > ackedSeq) {
      uint32_t highestQueued = 0;
      if (littleFsAvailable && LittleFS.exists("/buffer.ndjson")) {
        File file = LittleFS.open("/buffer.ndjson", FILE_READ);
        while (file && file.available())
          highestQueued = max(highestQueued, recordSeq(file.readStringUntil('\n')));
        file.close();
      }
      for (uint8_t i = 0; i < ramBufferCount; i++)
        highestQueued = max(highestQueued, recordSeq(ramBuffer[i]));
      if (requested > highestQueued) {
        server.send(400, "application/json", "{\"error\":\"upto exceeds queued sequence\"}");
        return;
      }
    }

    if (requested > pendingAckSeq) pendingAckSeq = requested;
    ackWritePending = true;
    if (requested > ackedSeq) ackedSeq = requested;
    Serial.printf("[BACKLOG] ACK seq=%lu\n", (unsigned long)requested);
    server.send(200, "application/json", "{\"ack\":\"accepted\"}");
  }

