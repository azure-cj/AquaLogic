    handleLED();
    handleFeeder();
    handleSyringeA();
    handleSyringeB();
    serviceBufferStorage();

    serviceTimeSyncDiagnostics();
    checkUvSchedule();
    checkLedSchedule();
    checkFeederSchedule();
    checkSyringeASchedule();
    checkSyringeBSchedule();

    static unsigned long sensorMillis=0;
    static unsigned long phDebugMillis=0;
    static unsigned long adcTestMillis=0;
    static unsigned long tdsTestMillis=0;

    if (
      millis()-sensorMillis>=2000
    ) {

      sensorMillis=
        millis();

      readSensors();

      evaluateTemperature();
      evaluatePH();
      evaluateTurbidity();
      evaluateTDS();
      evaluateOverallStatus();

      checkPhAutoDose();

      serialMonitorOutput();
      queueOfflineReading();
    }

    if (
      millis()-adcTestMillis>=1000
    ) {

      adcTestMillis=
        millis();

      Serial.print(
        "[ADC TEST] GPIO35 RAW: "
      );

      for (
        int i=0;
        i<4;
        i++
      ) {
        uint16_t rawSample=
          analogRead(
            PH_PIN
          );

        uint32_t mvSample=
          analogReadMilliVolts(
            PH_PIN
          );

        Serial.print(
          rawSample
        );

        Serial.print(
          " | mV: "
        );

        Serial.print(
          mvSample
        );

        if (
          i<3
        ) {
          Serial.print(
            "  |  "
          );
        }
      }

      Serial.println();
    }

    if (
      millis()-tdsTestMillis>=1000
    ) {

      tdsTestMillis=
        millis();

      Serial.print(
        "[TDS ADC TEST] GPIO34 RAW: "
      );

      for (
        int i=0;
        i<4;
        i++
      ) {
        uint16_t rawSample=
          analogRead(
            TDS_PIN
          );

        uint32_t mvSample=
          analogReadMilliVolts(
            TDS_PIN
          );

        Serial.print(
          rawSample
        );

        Serial.print(
          " | mV: "
        );

        Serial.print(
          mvSample
        );

        Serial.print(
          " | Cal V: "
        );

        Serial.print(
          mvSample/
          1000.0f,
          4
        );

        Serial.print(
          " V"
        );

        if (
          i<3
        ) {
          Serial.print(
            "  |  "
          );
        }
      }

      Serial.println();
    }

    if (
      millis()-phDebugMillis>=5000
    ) {

      phDebugMillis=
        millis();

      if (
        phRaw > 0
      ) {
        Serial.println("[PH DEBUG]");
        Serial.printf("RAW ADC: %d\n", phRaw);
        Serial.printf("ADC mV: %lu\n", (unsigned long)phMilliVolts);
        Serial.printf("Voltage: %.3f V\n", phVoltage);
        Serial.printf("Demo pH: %.2f\n", phValue);
      }
    }

    unsigned long lcdInterval=
      (lcdScreen==4)
        ?3000UL
        :2500UL;

    if (
      millis()-lcdPreviousMillis
      >=lcdInterval
    ) {

      lcdPreviousMillis=
        millis();

      if (!feederActive) {

        switch (lcdScreen) {

          case 0:
            displayTemperature();
            break;

          case 1:
            displayPH();
            break;

          case 2:
            displayTurbidity();
            break;

          case 3:
            displayTDS();
            break;

          case 4:
            displayOverallStatus();
            break;
        }
      }

      lcdScreen=
        (lcdScreen+1)%5;
    }
  }

