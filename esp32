  void startFeederMove(bool isTest) {

    if (feederActive) return;

    feederActive  = true;
    feederStartMs = millis();

    if (!isTest) {

      feedCount++;

      unsigned long totalSecs =
        millis() / 1000;

      char buf[12];

      sprintf(
        buf,
        "%02d:%02d:%02d",
        (int)((totalSecs / 3600) % 24),
        (int)((totalSecs % 3600) / 60),
        (int)(totalSecs % 60)
      );

      lastFedTime = String(buf);
    }

    Serial.print(
      isTest
        ? "SERVO TEST — angle: "
        : "FEED TRIGGERED — angle: "
    );

    Serial.print(feederOpenAngle);

    Serial.print(
      "  duration: "
    );

    Serial.print(feederDurationMs);

    Serial.println("ms");

    feederServo.write(
      feederOpenAngle
    );

    lcd.clear();

    lcd.setCursor(0, 0);

    lcd.print(
      isTest
        ? "SERVO TEST"
        : "FEEDING FISH!"
    );

    lcd.setCursor(0, 1);

    if (isTest)
      lcd.print("Testing...");
    else {
      lcd.print("Count: ");
      lcd.print(feedCount);
    }
  }

  void triggerFeed() {
    startFeederMove(false);
  }

  void testServo() {
    startFeederMove(true);
  }

  void handleFeeder() {

    if (!feederActive)
      return;

    if (
      millis() - feederStartMs
      >= feederDurationMs
    ) {

      feederServo.write(
        feederCloseAngle
      );

      feederActive=false;

      Serial.println(
        "FEEDER CLOSED"
      );
    }
  }

  void checkFeederSchedule() {
    struct tm localTime;
    if (!getDeviceLocalTime(localTime)) return;
    int nowMin = localTime.tm_hour * 60 + localTime.tm_min;
    int today = deviceDateKey(localTime);

    for (int i = 0; i < 3; i++) {
      if (!feedSchedule[i].enabled) continue;
      int slotMin = feedSchedule[i].hour * 60 + feedSchedule[i].minute;
      if (nowMin != slotMin || feedLastFiredDate[i] == today) continue;

      feedLastFiredDate[i] = today;
      feedSchedule[i].firedToday = true;
      char key[12];
      snprintf(key, sizeof(key), "feed_fire%d", i);
      if (!persistentStateReady || devicePreferences.putInt(key, today) == 0) {
        Serial.println("[SCHEDULE] FEEDER skipped; reason=PERSISTENCE_FAILED");
        continue;
      }

      if (feederActive) {
        Serial.printf("[SCHEDULE] FEEDER slot%d skipped at %02d:%02d; reason=ACTUATOR_BUSY\n",
          i + 1, localTime.tm_hour, localTime.tm_min);
        continue;
      }

      triggerFeed();
      Serial.printf("[SCHEDULE] FEEDER slot%d triggered at %02d:%02d:%02d\n",
        i + 1, localTime.tm_hour, localTime.tm_min, localTime.tm_sec);
    }
  }

