    async function dispenseA(){
      const status = await (await fetch('/syringeA/status')).json();
      if (!status.clock_synced) {
        fb('syrA-feedback', 'BLOCKED — Asia/Manila clock is not synchronized.');
        return;
      }
      if (status.refill_required) {
        const refillConfirmed = confirm(`Check Syringe A first. ${status.volume_known ? `Estimated remaining volume is ${status.remaining_ml.toFixed(2)} mL.` : 'Its initial fill has not been confirmed.'} The configured dose is ${status.volume_ml.toFixed(2)} mL. Only choose OK after you have physically refilled it to ${status.capacity_ml.toFixed(2)} mL. This confirmation does not move the motor or reset cooldown. Next eligible time: ${status.next_eligible_at || 'not reported'}.`);
        if (refillConfirmed) {
          const refill = await (await fetch('/syringeA/refill-confirm')).json();
          fb('syrA-feedback', refill.refill_confirmed ? 'Refill confirmed. Click DISPENSE NOW again to request a dose.' : `Refill not confirmed — ${refill.reason || 'try again'}`);
          setTimeout(fetchSyrA,300);
        }
        return;
      }
      if (!confirm(`Check Syringe A first. Confirm it contains enough liquid for the configured ${status.volume_ml.toFixed(2)} mL dose. Next eligible time: ${status.next_eligible_at || 'now'}. Chemical doses have a shared 2-hour minimum cooldown.`)) return;
