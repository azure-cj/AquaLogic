<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#EAF8FA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/aqualogic_splash_mark</item>
        <item name="android:statusBarColor">#EAF8FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#EAF8FA</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/normal_background</item>
        <item name="android:statusBarColor">#EAF8FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#EAF8FA</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
