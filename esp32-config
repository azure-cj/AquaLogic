// ========================

// checkPhAutoDose() calls triggerSyringeA()/B(), which internally enforce
// the 5mL volume limit. When a dose succeeds AND we're in demoMode (no real
// chemicals), we simulate the correction by snapping the fake pH reading
// back to the midpoint of the target range — this closes the demo loop
// without needing to manually reset the pH value after each auto-dose.

void checkPhAutoDose() {

  if (!phAutoDoseEnabled)
    return;

  if (
    syringeAActive ||
    syringeBActive
  )
    return;

  if (
    millis()-lastPhDoseMs <
    phDoseCooldownMs
  )
    return;

  if (
    phValue <
    phTargetMin
  ) {

    bool ok =
      triggerSyringeA();

    if (ok) {

      phAutoLastAction =
        "AUTO: pH UP dosed at pH "+
        String(phValue,2);

      if (demoMode) {

        demoPhValue =
          (
            phTargetMin+
            phTargetMax
          )/2.0f;

        phAutoLastAction +=
          " — pH reading updated to "+
          String(
            demoPhValue,
            2
          )+
          " (demo)";
      }

    } else {

      phAutoLastAction =
        "AUTO: pH UP BLOCKED — Syringe A low volume ("+
        String(
          syringeARemainingML,
          1
        )+
        "mL left)";
    }

    Serial.println(
      phAutoLastAction
    );

  } else if (
    phValue >
    phTargetMax
  ) {

    bool ok =
      triggerSyringeB();

    if (ok) {

      phAutoLastAction =
        "AUTO: pH DOWN dosed at pH "+
        String(phValue,2);

      if (demoMode) {

        demoPhValue =
          (
            phTargetMin+
            phTargetMax
          )/2.0f;

        phAutoLastAction +=
          " — pH reading updated to "+
          String(
            demoPhValue,
            2
          )+
          " (demo)";
      }

    } else {

      phAutoLastAction =
        "AUTO: pH DOWN BLOCKED — Syringe B low volume ("+
        String(
          syringeBRemainingML,
          1
        )+
        "mL left)";
    }

    Serial.println(
      phAutoLastAction
    );
  }
}

// ========================
// HTTP HANDLERS
// ========================

uint32_t recordSeq(const String& record) {
  int marker = record.indexOf("\"seq\":");
  return marker < 0 ? 0 : strtoul(record.c_str() + marker + 6, NULL, 10);
}

void writeBufferMeta() {
  if (!littleFsAvailable) return;

  File meta = LittleFS.open("/meta.json", FILE_WRITE);
  if (!meta) return;

  meta.print("{\"next_seq\":");
  meta.print(nextSeq);
  meta.print(",\"acked_seq\":");
  meta.print(ackedSeq);
  meta.print(",\"dropped\":");
  meta.print(droppedRecords);
  meta.println("}");
  meta.close();
}

void loadBufferMeta() {
  if (!LittleFS.exists("/meta.json")) return;

  File meta = LittleFS.open("/meta.json", FILE_READ);
  if (!meta) return;

  String json = meta.readString();
  meta.close();

  int marker = json.indexOf("\"next_seq\":");
  if (marker >= 0) nextSeq = strtoul(json.c_str() + marker + 11, NULL, 10);

  marker = json.indexOf("\"acked_seq\":");
  if (marker >= 0) ackedSeq = strtoul(json.c_str() + marker + 12, NULL, 10);

  marker = json.indexOf("\"dropped\":");
  if (marker >= 0) droppedRecords = strtoul(json.c_str() + marker + 10, NULL, 10);

  if (nextSeq == 0) nextSeq = 1;
}

void reserveSequenceRange() {
  seqCursor = nextSeq;
  seqLimit = seqCursor + SEQ_RESERVATION_SIZE;
  nextSeq = seqLimit;
  writeBufferMeta();
}

void setupBufferStorage() {
  littleFsAvailable = LittleFS.begin(true);
  if (!littleFsAvailable) {
    Serial.println("LittleFS unavailable; using RAM-only offline buffer");
    return;
  }

  loadBufferMeta();
  reserveSequenceRange();
  Serial.println("LittleFS offline buffer ready");
}

String makeBufferedRecord() {
  if (seqCursor >= seqLimit) reserveSequenceRange();

  String record = "{\"seq\":" + String(seqCursor++) +
    ",\"temp_c\":" + String(temperatureC, 2) +
    ",\"temp_status\":\"" + tempStatus +
    "\",\"ph_value\":" + String(phValue, 2) +
    ",\"ph_status\":\"" + phStatus +
    "\",\"turbidity_ntu\":" + String(turbidityNtu, 1) +
    ",\"turbidity_status\":\"" + turbidityStatus +
    "\",\"tds_ppm\":" + String(tdsPpm, 0) +
    ",\"tds_status\":\"" + tdsStatus +
    "\",\"overall_status\":\"" + overallStatus + "\"}";
  return record;
}

void queueOfflineReading() {
  if (wifiConnected) return;

  if (ramBufferCount >= RAM_QUEUE_CAPACITY) {
    for (uint8_t i = 1; i < ramBufferCount; i++) ramBuffer[i - 1] = ramBuffer[i];
    ramBufferCount--;
    droppedRecords++;
  }

  ramBuffer[ramBufferCount++] = makeBufferedRecord();
}

void rewriteBuffer(uint32_t recordsToDrop) {
  if (!littleFsAvailable) return;

  File source = LittleFS.open("/buffer.ndjson", FILE_READ);
  File temp = LittleFS.open("/buffer.tmp", FILE_WRITE);
  if (!temp) {
    source.close();
    return;
  }

  uint32_t dropped = 0;
  while (source && source.available()) {
    String line = source.readStringUntil('\n');
    uint32_t seq = recordSeq(line);
    if (seq == 0 || seq <= ackedSeq) continue;
    if (dropped < recordsToDrop) {
      dropped++;
      droppedRecords++;
      continue;
    }
    temp.println(line);
  }

  source.close();
  temp.close();
  LittleFS.remove("/buffer.ndjson");
  LittleFS.rename("/buffer.tmp", "/buffer.ndjson");
  writeBufferMeta();
}

void trimBufferToCaps() {
  if (!littleFsAvailable || !LittleFS.exists("/buffer.ndjson")) return;

  File file = LittleFS.open("/buffer.ndjson", FILE_READ);
  uint32_t records = 0;
  size_t bytes = 0;
  while (file && file.available()) {
    String line = file.readStringUntil('\n');
    uint32_t seq = recordSeq(line);
    if (seq > ackedSeq) {
      records++;
      bytes += line.length() + 1;
    }
  }
  file.close();

  uint32_t toDrop = 0;
  while (records > BUFFER_MAX_RECORDS || bytes > BUFFER_MAX_BYTES) {
    File oldest = LittleFS.open("/buffer.ndjson", FILE_READ);
    while (oldest && oldest.available() && toDrop <= records) {
      String line = oldest.readStringUntil('\n');
      uint32_t seq = recordSeq(line);
      if (seq > ackedSeq) {
        bytes -= line.length() + 1;
        records--;
        toDrop++;
        break;
      }
    }
    oldest.close();
  }

  if (toDrop > 0) rewriteBuffer(toDrop);
}

void compactAckedBuffer() {
  if (!littleFsAvailable || !LittleFS.exists("/buffer.ndjson")) return;

  File source = LittleFS.open("/buffer.ndjson", FILE_READ);
  File temp = LittleFS.open("/buffer.tmp", FILE_WRITE);
  if (!temp) {
    source.close();
    return;
  }

  while (source && source.available()) {
    String line = source.readStringUntil('\n');
    if (recordSeq(line) > ackedSeq) temp.println(line);
  }
  source.close();
  temp.close();
  LittleFS.remove("/buffer.ndjson");
  LittleFS.rename("/buffer.tmp", "/buffer.ndjson");
  writeBufferMeta();
}

bool ackedPortionExceedsThreshold() {
  if (!littleFsAvailable || !LittleFS.exists("/buffer.ndjson")) return false;

  File file = LittleFS.open("/buffer.ndjson", FILE_READ);
  uint32_t total = 0;
  uint32_t acknowledged = 0;
  while (file && file.available()) {
    uint32_t seq = recordSeq(file.readStringUntil('\n'));
    if (seq == 0) continue;
    total++;
    if (seq <= ackedSeq) acknowledged++;
  }
  file.close();
  return total > 0 && acknowledged * 4 >= total;
}

void flushOfflineBuffer() {
  if (wifiConnected || ramBufferCount == 0 || feederActive || syringeAActive || syringeBActive) return;
  if (!littleFsAvailable) return;
  if (!LittleFS.exists("/buffer.ndjson")) {
    File file = LittleFS.open("/buffer.ndjson", FILE_WRITE);
    file.close();
  }

  File file = LittleFS.open("/buffer.ndjson", FILE_APPEND);
  if (!file) return;
  for (uint8_t i = 0; i < ramBufferCount; i++) file.println(ramBuffer[i]);
  file.close();
  ramBufferCount = 0;
  bufferLastFlushAt = millis();
  trimBufferToCaps();
}

void serviceBufferStorage() {
  if (feederActive || syringeAActive || syringeBActive) return;

  if (ackWritePending) {
    if (pendingAckSeq > ackedSeq) ackedSeq = pendingAckSeq;
    ackWritePending = false;
    writeBufferMeta();
    // Keep acknowledged lines until they exceed 25% so routine bridge acks do not rewrite flash.
    if (ackedPortionExceedsThreshold()) compactAckedBuffer();
  }

  if (!wifiConnected && ramBufferCount >= RAM_QUEUE_MAX)
    flushOfflineBuffer();
  else if (!wifiConnected && ramBufferCount > 0 &&
           millis() - bufferLastFlushAt >= BUFFER_FLUSH_INTERVAL_MS)
    flushOfflineBuffer();
}

void showManualWiFiNotice(const char* line1, const char* line2) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(line1);
  lcd.setCursor(0, 1);
  lcd.print(line2);
}

void enterManualOfflineMode() {
  if (mdnsStarted) {
    MDNS.end();
    mdnsStarted = false;
  }

  WiFi.disconnect(true);
  WiFi.mode(WIFI_AP);
  bool apStarted = WiFi.softAP(DEBUG_AP_SSID, DEBUG_AP_PASSWORD);
  manualOfflineMode = true;
  manualOfflineSetAt = millis();
  wifiConnected = false;
  wifiConnecting = false;

  Serial.print("Manual WiFi offline mode; AP ");
  Serial.print(apStarted ? "started at " : "failed: ");
  Serial.println(WiFi.softAPIP());
  showManualWiFiNotice("DEBUG AP READY", "192.168.4.1");
}

void exitManualOfflineMode() {
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  manualOfflineMode = false;
  pendingManualReconnect = false;
  wifiConnecting = false;
  wifiLastRetryAt = 0;
  Serial.println("Manual WiFi offline mode ended; STA reconnect enabled");
}

void serviceManualWiFi() {
  if (pendingManualOffline) {
    pendingManualOffline = false;
    if (!manualOfflineMode) enterManualOfflineMode();
    return;
  }

  if (pendingManualReconnect) {
    if (manualOfflineMode) exitManualOfflineMode();
    else pendingManualReconnect = false;
  }

  if (manualOfflineMode && millis() - manualOfflineSetAt >= MANUAL_OFFLINE_MAX_MS) {
    pendingManualReconnect = true;
    Serial.println("MANUAL OFFLINE MODE AUTO-CLEARED (safety timeout)");
    showManualWiFiNotice("OFFLINE TIMEOUT", "RECONNECTING");
    exitManualOfflineMode();
  }
}

void serviceWiFi() {
  if (manualOfflineMode) return;

  bool connectedNow = WiFi.status() == WL_CONNECTED;
  if (connectedNow) {
    if (!wifiConnected) {
      wifiConnected = true;
      wifiConnecting = false;
      Serial.println("WiFi connected: " + WiFi.localIP().toString());
      if (!mdnsStarted && MDNS.begin("aqualogic")) {
        MDNS.addService("http", "tcp", 80);
        mdnsStarted = true;
        Serial.println("mDNS responder started: http://aqualogic.local");
      }
    }
    return;
  }

  if (wifiConnected) {
    wifiConnected = false;
    Serial.println("WiFi disconnected; offline buffering enabled");
  }

  unsigned long now = millis();
  if (wifiConnecting && now - wifiConnectStartedAt < WIFI_CONNECT_TIMEOUT_MS) return;
  if (now - wifiLastRetryAt < WIFI_RETRY_INTERVAL_MS) return;

  WiFi.begin(ssid, password);
  wifiConnecting = true;
  wifiConnectStartedAt = now;
  wifiLastRetryAt = now;
}

const char* wifiModeName() {
  wifi_mode_t mode = WiFi.getMode();
  if (mode == WIFI_STA) return "STA";
  if (mode == WIFI_AP) return "AP";
  return "OFF";
}

