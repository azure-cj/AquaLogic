  json+="}";

  server.send(
    200,
    "application/json",
    json
  );
}

void handleLedOn() {

  ledState=true;
  ledOnDuration=0;
  ledTurnedOnAt=millis();

  digitalWrite(
    LED_PIN,
    HIGH
  );

  server.send(
    200,
    "application/json",
    "{\"led\":\"on\"}"
  );
}

void handleLedOff() {

  ledState=false;
  ledOnDuration=0;

  digitalWrite(
    LED_PIN,
    LOW
  );

  server.send(
    200,
    "application/json",
    "{\"led\":\"off\"}"
  );
}

void handleLedTimer() {

  if (
    server.hasArg("duration")
  ) {

    ledOnDuration=
      server.arg(
        "duration"
      ).toInt();

    ledState=true;

    ledTurnedOnAt=
      millis();

    digitalWrite(
      LED_PIN,
      HIGH
    );

    server.send(
      200,
      "application/json",
      "{\"led\":\"timer\"}"
    );

  } else {

    server.send(
      400,
      "application/json",
      "{\"error\":\"missing duration\"}"
    );
  }
}

void handleLedSchedule() {

  if (
    server.hasArg("enabled")
  )
    ledScheduleEnabled=
      server.arg(
        "enabled"
      ).toInt()==1;

  if (
    server.hasArg("onH")
  )
    ledScheduleOnHour=
      server.arg(
        "onH"
      ).toInt();

  if (
    server.hasArg("onM")
  )
    ledScheduleOnMinute=
      server.arg(
        "onM"
      ).toInt();

  if (
    server.hasArg("offH")
  )
    ledScheduleOffHour=
      server.arg(
        "offH"
      ).toInt();

  if (
    server.hasArg("offM")
  )
    ledScheduleOffMinute=
      server.arg(
        "offM"
      ).toInt();

  server.send(
    200,
    "application/json",
    "{\"schedule\":\"saved\"}"
  );
}

void checkLedSchedule() {

  if (
    !ledScheduleEnabled
  )
    return;

  unsigned long totalSecs=
    millis()/1000;

  int nowMins=
    ((totalSecs/3600)%24)*60+
    ((totalSecs%3600)/60);

  int onMins=
    ledScheduleOnHour*60+
    ledScheduleOnMinute;

  int offMins=
    ledScheduleOffHour*60+
    ledScheduleOffMinute;

  bool shouldBeOn=
    (onMins<offMins)
      ?
      (
        nowMins>=onMins &&
        nowMins<offMins
      )
      :
      (
        nowMins>=onMins ||
        nowMins<offMins
      );

  if (
    shouldBeOn &&
    !ledState &&
    ledOnDuration==0
  ) {

    ledState=true;

    ledTurnedOnAt=
      millis();

    digitalWrite(
      LED_PIN,
      HIGH
    );

  } else if (
    !shouldBeOn &&
    ledState &&
    ledOnDuration==0
  ) {

    ledState=false;

    digitalWrite(
      LED_PIN,
      LOW
    );
  }
}

