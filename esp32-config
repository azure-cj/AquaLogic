void startFeederMove(bool isTest) {

  if (feederActive) return;

  feederActive  = true;
  feederStartMs = millis();

  if (!isTest) {

    feedCount++;

    unsigned long totalSecs =
      millis() / 1000;

    char buf[12];

    sprintf(
      buf,
      "%02d:%02d:%02d",
      (int)((totalSecs / 3600) % 24),
      (int)((totalSecs % 3600) / 60),
      (int)(totalSecs % 60)
    );

    lastFedTime = String(buf);
  }

  Serial.print(
    isTest
      ? "SERVO TEST — angle: "
      : "FEED TRIGGERED — angle: "
  );

  Serial.print(feederOpenAngle);

  Serial.print(
    "  duration: "
  );

  Serial.print(feederDurationMs);

  Serial.println("ms");

  feederServo.write(
    feederOpenAngle
  );

  lcd.clear();

  lcd.setCursor(0, 0);

  lcd.print(
    isTest
      ? "SERVO TEST"
      : "FEEDING FISH!"
  );

  lcd.setCursor(0, 1);

  if (isTest)
    lcd.print("Testing...");
  else {
    lcd.print("Count: ");
    lcd.print(feedCount);
  }
}

void triggerFeed() {
  startFeederMove(false);
}

void testServo() {
  startFeederMove(true);
}

void handleFeeder() {

  if (!feederActive)
    return;

  if (
    millis() - feederStartMs
    >= feederDurationMs
  ) {

    feederServo.write(
      feederCloseAngle
    );

    feederActive=false;

    Serial.println(
      "FEEDER CLOSED"
    );
  }
}

void checkFeederSchedule() {

  unsigned long totalSecs =
    millis()/1000;

  int nowH =
    (totalSecs/3600)%24;

  int nowM =
    (totalSecs%3600)/60;

  int nowMin =
    nowH*60+nowM;

  if (
    nowM != lastClockMinute
  ) {

    lastClockMinute=nowM;

    for (
      int i=0;
      i<3;
      i++
    )
      feedSchedule[i].firedToday=false;
  }

  for (
    int i=0;
    i<3;
    i++
  ) {

    if (
      !feedSchedule[i].enabled
    )
      continue;

    int slotMin =
      feedSchedule[i].hour*60+
      feedSchedule[i].minute;

    if (
      nowMin==slotMin &&
      !feedSchedule[i].firedToday &&
      !feederActive
    ) {

      feedSchedule[i].firedToday=true;

      triggerFeed();
    }
  }
}

