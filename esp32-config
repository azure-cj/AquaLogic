void checkUvSchedule() {

  if (
    !uvScheduleEnabled
  )
    return;

  unsigned long totalSecs=
    millis()/1000;

  int nowMins=
    ((totalSecs/3600)%24)*60+
    ((totalSecs%3600)/60);

  int onMins=
    uvScheduleOnHour*60+
    uvScheduleOnMinute;

  int offMins=
    uvScheduleOffHour*60+
    uvScheduleOffMinute;

  bool shouldBeOn=
    (onMins<offMins)
      ?
      (
        nowMins>=onMins &&
        nowMins<offMins
      )
      :
      (
        nowMins>=onMins ||
        nowMins<offMins
      );

  if (
    shouldBeOn &&
    !uvState &&
    uvOnDuration==0
  ) {

    uvState=true;

    uvTurnedOnAt=
      millis();

    digitalWrite(
      UV_PIN,
      HIGH
    );

  } else if (
    !shouldBeOn &&
    uvState &&
    uvOnDuration==0
  ) {

    uvState=false;

    digitalWrite(
      UV_PIN,
      LOW
    );
  }
}

