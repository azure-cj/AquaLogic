// ========================
// LOOP
// ========================

void loop() {

  serviceManualWiFi();
  serviceWiFi();
  server.handleClient();

  handleUV();
  handleLED();
  handleFeeder();
  handleSyringeA();
  handleSyringeB();
  serviceBufferStorage();

  checkUvSchedule();
  checkLedSchedule();
  checkFeederSchedule();
  checkSyringeASchedule();
  checkSyringeBSchedule();

  static unsigned long sensorMillis=0;

  if (
    millis()-sensorMillis>=2000
  ) {

    sensorMillis=
      millis();

    readSensors();

    evaluateTemperature();
    evaluatePH();
    evaluateTurbidity();
    evaluateTDS();
    evaluateOverallStatus();

    checkPhAutoDose();

    serialMonitorOutput();
    queueOfflineReading();
  }

  unsigned long lcdInterval=
    (lcdScreen==4)
      ?3000UL
      :2500UL;

  if (
    millis()-lcdPreviousMillis
    >=lcdInterval
  ) {

    lcdPreviousMillis=
      millis();

    if (!feederActive) {

      switch (lcdScreen) {

        case 0:
          displayTemperature();
          break;

        case 1:
          displayPH();
          break;

        case 2:
          displayTurbidity();
          break;

        case 3:
          displayTDS();
          break;

        case 4:
          displayOverallStatus();
          break;
      }
    }

    lcdScreen=
      (lcdScreen+1)%5;
  }
}

// ========================
// SENSOR FUNCTIONS
// ========================

void readSensors() {

  sensors.requestTemperatures();

  temperatureC=
    sensors.getTempCByIndex(0);

  turbidityRaw=
    getAverageAnalog(
      TURBIDITY_PIN
    );

  tdsRaw=
    getAverageAnalog(
      TDS_PIN
    );

  phRaw=
    getAverageAnalog(
      PH_PIN
    );

  float turbidityVoltage=
    turbidityRaw*
    (3.3f/4095.0f);

  turbidityNtu=
    calibrateTurbidityNTU(
      turbidityVoltage
    );

  float tdsVoltage=
    tdsRaw*
    (3.3f/4095.0f);

  tdsPpm=
    calibrateTdsPPM(
      tdsVoltage,
      temperatureC
    );

  float voltage=
    phRaw*
    (3.3f/4095.0f);

  phValue=
    3.5f*
    voltage+
    0.0f;

  if (demoMode)
    phValue=
      demoPhValue;
}

int getAverageAnalog(
  int pin
) {

  long total=0;

  for (
    int i=0;
    i<10;
    i++
  ) {

    total +=
      analogRead(pin);

    delay(1);
  }

  return total/10;
}

float calibrateTurbidityNTU(
  float voltage
) {

  if (
    voltage<=0.0f
  )
    return 3000.0f;

  if (
    voltage<2.5f
  )
    return 3000.0f;

  float ntu=
    -1120.4f*
    voltage*
    voltage
    +
    5742.3f*
    voltage
    -
    4352.9f;

  return constrain(
    ntu,
    0.0f,
    3000.0f
  );
}

float calibrateTdsPPM(
  float voltage,
  float temperature
) {

  if (
    voltage<=0.0f
  )
    return 0.0f;

  float compensationCoefficient=
    1.0f+
    0.02f*
    (temperature-25.0f);

  float compensatedVoltage=
    voltage/
    compensationCoefficient;

  float tds=
    (
      133.42f*
      compensatedVoltage*
      compensatedVoltage*
      compensatedVoltage

      -
      255.86f*
      compensatedVoltage*
      compensatedVoltage

      +
      857.39f*
      compensatedVoltage
    )*
    0.5f;

  return constrain(
    tds,
    0.0f,
    3000.0f
  );
}

// ========================
// EVALUATION
// ========================

void evaluateTemperature() {

  if (
    temperatureC==
    DEVICE_DISCONNECTED_C
  )
    tempStatus=
      "NO SENSOR";

  else if (
    temperatureC>=24 &&
    temperatureC<=30
  )
    tempStatus=
      "NORMAL";

  else if (
    temperatureC>30
  )
    tempStatus=
      "HIGH";

  else
    tempStatus=
      "LOW";
}

void evaluatePH() {

  if (
    phValue>=6.5 &&
    phValue<=8.5
  )
    phStatus=
      "NORMAL";

  else if (
    phValue>=5.0 &&
    phValue<6.5
  )
    phStatus=
      "ACIDIC";

  else if (
    phValue>8.5 &&
    phValue<=9.5
  )
    phStatus=
      "ALKALINE";

  else
    phStatus=
      "CRITICAL";
}

void evaluateTurbidity() {

  if (
    turbidityRaw>2500
  )
    turbidityStatus=
      "CLEAR";

  else if (
    turbidityRaw>1500
  )
    turbidityStatus=
      "MODERATE";

  else
    turbidityStatus=
      "DIRTY";
}

void evaluateTDS() {

  if (
    tdsRaw<800
  )
    tdsStatus=
      "LOW";

  else if (
    tdsRaw<=2200
  )
    tdsStatus=
      "NORMAL";

  else
    tdsStatus=
      "HIGH";
}

void evaluateOverallStatus() {

  if (
    tempStatus=="NORMAL" &&
    turbidityStatus=="CLEAR" &&
    tdsStatus=="NORMAL" &&
    phStatus=="NORMAL"
  )
    overallStatus=
      "GOOD";

  else if (
    turbidityStatus=="DIRTY" ||
    tdsStatus=="HIGH" ||
    phStatus=="CRITICAL"
  )
    overallStatus=
      "CRITICAL";

  else
    overallStatus=
      "MONITOR";
}

