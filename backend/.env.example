DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/aqualogic
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
PUBLIC_BASE_URL=https://your-app.vercel.app
DEMO_SENSOR_ENABLED=false
DEMO_SENSOR_INSTANCE=false
DEMO_SENSOR_INTERVAL_SECONDS=30
ANALYTICS_UPTIME_WARNING=99
ANALYTICS_UPTIME_CRITICAL=95
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-before-deploying
