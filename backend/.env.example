DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/aqualogic
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ISSUER=aqualogic-api
JWT_AUDIENCE=aqualogic-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_SESSION_EXPIRE_DAYS=7
ENVIRONMENT=production
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
TRUSTED_HOSTS=your-app.onrender.com,localhost
PUBLIC_BASE_URL=https://your-app.vercel.app
PUBLIC_IMAGE_HOSTS=
MEDIA_ROOT=./media
MAX_HERO_IMAGE_BYTES=5242880
MAX_FISH_IMAGE_BYTES=5242880
DEMO_SENSOR_ENABLED=false
DEMO_SENSOR_INSTANCE=false
DEMO_SENSOR_INTERVAL_SECONDS=30
DEMO_EXHIBIT_DATE=2026-10-13
# Production demo is permitted only with a future UTC deadline at most 7 days away.
# EXHIBIT_DEMO_UNTIL=2026-10-14T23:59:00Z
ANALYTICS_UPTIME_WARNING=99
ANALYTICS_UPTIME_CRITICAL=95
MONITORING_INCIDENTS_ENABLED=true
MONITORING_OUTAGE_GRACE_SECONDS=900
MONITORING_INCIDENT_CHECK_INTERVAL_SECONDS=60
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_DISPATCH_INTERVAL_SECONDS=15
# Configure FIREBASE_SERVICE_ACCOUNT_JSON_B64 only in the deployment secret store.
# FIREBASE_PROJECT_ID is an optional non-secret project ID consistency check.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-before-deploying
